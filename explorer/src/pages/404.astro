---
import Base from "../layouts/Base.astro";
---

<Base title="Not found — SFIA Explorer" description="Page not found.">
  <section class="mx-auto flex w-full max-w-xl flex-1 flex-col items-center justify-center gap-4 px-5 py-16 text-center">
    <p class="font-mono text-xs text-muted-foreground">404</p>
    <h1 class="text-2xl font-medium tracking-tight">That page does not exist</h1>
    <p class="text-sm text-muted-foreground">Try the matcher or browse the SFIA skill catalogue.</p>
    <div class="flex gap-2">
      <a class="inline-flex h-9 items-center rounded-2xl bg-foreground px-4 text-sm font-medium text-background" href="/">Analyze a role</a>
      <a class="inline-flex h-9 items-center rounded-2xl border px-4 text-sm font-medium hover:bg-muted" href="/skills/">Browse skills</a>
    </div>
  </section>
</Base>
