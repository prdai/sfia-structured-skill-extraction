{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sfia-explorer",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "6503f7d355399abee9e748d3100675d4",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "ai": {
    "binding": "AI"
  },
  "ai_search": [
    {
      "binding": "AI_SEARCH",
      "instance_name": "sfia-corpus"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "MATCH_CACHE",
      "id": "dc3452b6379e4a1b88046eaca295d429"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "BUDGET",
        "class_name": "Budget"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Budget"]
    }
  ],
  "analytics_engine_datasets": [
    {
      "binding": "QUERIES",
      "dataset": "sfia_queries"
    }
  ],
  "routes": [
    {
      "pattern": "sfia.prdai.dev",
      "custom_domain": true
    }
  ],
  "vars": {
    "APP_ORIGIN": "https://sfia.prdai.dev",
    "MODEL": "@cf/nvidia/nemotron-3-120b-a12b",
    "MONTHLY_MATCH_BUDGET": "500"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
